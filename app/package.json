{
  "name": "northpeak-store-ops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch server/server.ts",
    "predev": "npm run db:generate",
    "build": "echo \"[build] no-op: dist/ is prebuilt locally (npm run build:source / scripts/build-app.sh) and shipped via the bundle. The Apps container just installs deps and runs dist/server.js.\"",
    "build:source": "tsdown --config tsdown.server.config.ts && vite build --config client/vite.config.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc -b",
    "typegen": "appkit typegen",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "smoke": "playwright test"
  },
  "dependencies": {
    "@databricks/appkit": "0.66.1",
    "@databricks/appkit-ui": "0.66.1",
    "@openai/agents": "^0.17.0",
    "drizzle-orm": "^0.45.2",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "jsonc-parser": "^3.3.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.554.0",
    "mlflow-tracing": "^0.1.3",
    "openai": "^7.5.0",
    "pg": "^8.18.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.9.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.0",
    "@types/express": "^4.17.23",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "postcss": "^8.4.49",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "tsdown": "^0.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
